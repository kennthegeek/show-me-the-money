# =============================================================================
# Dropship pipeline: copy to .env and fill in.   cp .env.example .env
# Every safety switch below defaults to the SAFE value. Read README "Going live".
# =============================================================================

# --- Safety / spending guards ------------------------------------------------
# DRY_RUN=true: read from APIs, compute everything, log what WOULD happen, write nothing.
DRY_RUN=true
# Must be true (and DRY_RUN=false) before the pipeline pays supplier orders from your balance.
# While false, orders are placed at the supplier but you pay them by hand in the supplier dashboard.
ENABLE_SUPPLIER_PAYMENTS=false
# Hard caps in store currency. An order over either cap is parked in needs_review.
MAX_ORDER_COST=75
DAILY_SPEND_CAP=300
# Destination countries you ship to (ISO-2). Anything else goes to needs_review.
ALLOWED_COUNTRIES=US,CA,GB,AU
# Only route orders whose financial_status is "paid".
REQUIRE_PAID_ORDERS=true
# Retries for a failing order step before it is parked for review.
MAX_ORDER_ATTEMPTS=5

# --- Storage / logging ---------------------------------------------------------
# SQLite (default) or PostgreSQL: postgresql://user:pass@host:5432/dropship (pip install ".[postgres]")
DATABASE_URL=sqlite:///data/dropship.db
LOG_LEVEL=INFO
LOG_FILE=data/dropship.log

# --- Storefront: Shopify --------------------------------------------------------
# STOREFRONT=shopify | mock (mock = in-memory, for local testing)
STOREFRONT=shopify
# your-store or your-store.myshopify.com
SHOPIFY_SHOP=your-store.myshopify.com
# Admin API access token from a custom app (Settings > Apps > Develop apps).
# Scopes: write_products, write_inventory, read_locations, read_orders,
#         write_merchant_managed_fulfillment_orders, write_fulfillments
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-10
# The app's API secret key, used to verify X-Shopify-Hmac-Sha256 on webhooks.
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numeric id or gid of the location that holds dropship stock (Settings > Locations, id in URL).
SHOPIFY_LOCATION_ID=12345678901
# Let Shopify send its own "shipping confirmation" email when we add tracking.
SHOPIFY_NOTIFY_CUSTOMER=true
# Client-side request rate. Shopify also enforces GraphQL cost limits (handled automatically).
SHOPIFY_RATE_PER_SEC=2
# Status for newly imported products: DRAFT (review first, recommended) or ACTIVE.
PUBLISH_STATUS=DRAFT

# --- Supplier: CJ Dropshipping ---------------------------------------------------
# SUPPLIER=cj | mock
SUPPLIER=cj
# CJ dashboard > Authorization > API > generate API key.
CJ_API_KEY=CJxxxxxxxx@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_LOGISTIC_NAME=CJPacket Ordinary
CJ_FROM_COUNTRY=CN
# CJ throttles hard on lower tiers; 1 req/s is safe.
SUPPLIER_RATE_PER_SEC=1
# Imported SKUs look like DS-CJ-<variantId>; this is how orders get matched to the supplier.
SKU_PREFIX=DS

# --- Product sourcing --------------------------------------------------------------
NICHE_KEYWORDS=pet hair remover,led desk lamp,posture corrector
IMPORT_PER_KEYWORD=5
# Skip variants with less supplier stock than this.
MIN_SUPPLIER_STOCK=50
MAX_IMAGES=8

# --- Markup pricing ----------------------------------------------------------------
# Tiers by landed cost (supplier cost + shipping, converted). First tier whose max_cost >= cost wins.
PRICING_TIERS=[{"max_cost": 5, "multiplier": 3.0}, {"max_cost": 20, "multiplier": 2.5}, {"max_cost": 60, "multiplier": 2.0}, {"max_cost": null, "multiplier": 1.6}]
# Added after the multiplier.
PRICING_FIXED_MARKUP=0
# Include supplier shipping cost in landed cost (recommended if you offer free shipping).
PRICING_INCLUDE_SHIPPING=true
# Floors: price is never below cost + MIN_PROFIT, nor below the MIN_MARGIN_PCT margin.
PRICING_MIN_PROFIT=5.00
PRICING_MIN_MARGIN_PCT=25
# Round up to a price ending in .99 (empty to disable).
PRICING_CHARM_ENDING=0.99
# "Compare at" (strikethrough) price = price x this. 0 disables.
PRICING_COMPARE_AT_MULTIPLIER=1.4
# Supplier currency -> store currency (CJ quotes USD; e.g. 1.52 for an AUD store).
PRICING_CURRENCY_RATE=1

# --- Inventory & price sync ------------------------------------------------------------
# Listed quantity = supplier stock - STOCK_BUFFER (protects against stock shared with other sellers).
STOCK_BUFFER=5
# Supplier stock at/below this is treated as 0.
OUT_OF_STOCK_THRESHOLD=3
# Draft a product when every variant is out of stock; re-activate when stock returns.
AUTO_PAUSE_OOS=true
# Recompute prices when wholesale cost changes.
AUTO_REPRICE=true
# Alert when a wholesale cost moves by at least this percentage.
COST_CHANGE_ALERT_PCT=10

# --- Worker schedule (seconds) -----------------------------------------------------------
ORDER_ROUTER_INTERVAL=60
INVENTORY_SYNC_INTERVAL=900
TRACKING_SYNC_INTERVAL=1800
# 0 = run sourcing manually only (recommended). e.g. 86400 = daily import.
SOURCING_INTERVAL=0
TRACKING_STALE_DAYS=12

# --- Webhook listener ---------------------------------------------------------------------
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080

# --- Customer email (tracking links) ----------------------------------------------------------
# shopify = Shopify's shipping-confirmation email | smtp = our own email | both | none
EMAIL_MODE=shopify
STORE_NAME=Your Store
SMTP_HOST=smtp.postmarkapp.com
# 587 = STARTTLS, 465 = implicit TLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=orders@yourstore.com

# --- Operator alerts -------------------------------------------------------------------------
# Slack or Discord incoming-webhook URL.
ALERT_WEBHOOK_URL=
# Also email alerts here (uses the SMTP settings above).
ALERT_EMAIL=
# Same alert key is sent at most once per this many seconds.
ALERT_COOLDOWN_SEC=900
