{
  "name": "legacy-de-spaghetti",
  "version": "0.1.0",
  "description": "Scan messy legacy JS/TS codebases, wrap them in a characterization-test safety net, and refactor giant functions into clean, verified code.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "product": {
    "displayName": "Legacy-De-Spaghetti",
    "category": "dev-tools",
    "entry": "src/main.ts",
    "bin": "despaghetti"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "test": "vitest run --root ../.. dev-tools/legacy-de-spaghetti",
    "build": "tsx ../../scripts/build-all.ts --only legacy-de-spaghetti"
  },
  "dependencies": {
    "@products/shared": "*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ora": "^9.4.1",
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7",
    "simple-git": "^4.0.2",
    "diff": "^9.0.0",
    "picomatch": "^4.0.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  },
  "keywords": [
    "refactoring",
    "legacy-code",
    "characterization-tests",
    "code-quality",
    "cli"
  ]
}
